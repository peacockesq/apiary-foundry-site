    "test:ui": "playwright test --ui",
    "test:update-snapshots": "playwright test --update-snapshots",
    "install-browsers": "playwright install chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
